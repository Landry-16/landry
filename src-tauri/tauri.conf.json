{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Landry",
  "version": "0.4.0",
  "identifier": "dev.landry.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "bar",
        "title": "Landry",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Compagnon du quotidien",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/gnome-shell/extensions/landry@landry-16.github.io/extension.js": "../extension/landry@landry-16.github.io/extension.js",
          "/usr/share/gnome-shell/extensions/landry@landry-16.github.io/metadata.json": "../extension/landry@landry-16.github.io/metadata.json",
          "/usr/share/doc/landry/LICENSE": "../LICENSE",
          "/usr/share/doc/landry/THIRD_PARTY_LICENSES.md": "../THIRD_PARTY_LICENSES.md"
        },
        "depends": [
          "xdg-desktop-portal-gnome",
          "zip"
        ],
        "recommends": [
          "playerctl",
          "wireplumber",
          "network-manager",
          "tesseract-ocr",
          "tesseract-ocr-fra",
          "git",
          "gnome-keyring",
          "ffmpeg",
          "imagemagick",
          "poppler-utils",
          "ghostscript",
          "ripgrep"
        ]
      },
      "rpm": {
        "files": {
          "/usr/share/gnome-shell/extensions/landry@landry-16.github.io/extension.js": "../extension/landry@landry-16.github.io/extension.js",
          "/usr/share/gnome-shell/extensions/landry@landry-16.github.io/metadata.json": "../extension/landry@landry-16.github.io/metadata.json",
          "/usr/share/doc/landry/LICENSE": "../LICENSE",
          "/usr/share/doc/landry/THIRD_PARTY_LICENSES.md": "../THIRD_PARTY_LICENSES.md"
        },
        "depends": [
          "xdg-desktop-portal-gnome",
          "zip"
        ],
        "recommends": [
          "playerctl",
          "wireplumber",
          "NetworkManager",
          "tesseract",
          "git",
          "gnome-keyring",
          "ImageMagick",
          "poppler-utils",
          "ghostscript",
          "ripgrep"
        ]
      }
    },
    "copyright": "Copyright (c) 2026 Landry-16",
    "license": "MIT",
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
